---
import type { CollectionEntry } from 'astro:content';
interface Props { projets: CollectionEntry<'projets'>[] }
const { projets } = Astro.props;
// 0-100 ramené à 4-96 % pour que les points du bord restent lisibles et cliquables
const pos = (v: number) => 4 + v * 0.92;
---
<figure class="carte">
  <div class="plan">
    <span class="axe axe-x" aria-hidden="true"></span>
    <span class="axe axe-y" aria-hidden="true"></span>
    <span class="lib lib-g">expérimental</span>
    <span class="lib lib-d">dansant</span>
    <span class="lib lib-h">chill</span>
    <span class="lib lib-b">dark</span>
    {projets.map((p, i) => (
      <div class:list={['point', { gauche: p.data.x >= 70 }]} style={`--px:${pos(p.data.x)};--py:${pos(p.data.y)};--i:${i};--ancre:--jack-${i}`}>
        <span class="guide guide-x" aria-hidden="true"></span>
        <span class="guide guide-y" aria-hidden="true"></span>
        <button class="jack" type="button" popovertarget={`pop-${p.id}`} aria-label={p.data.title}></button>
        <span class="nom" aria-hidden="true">{p.data.title}</span>
        <div class="pop" id={`pop-${p.id}`} popover>
          <button class="fermer" type="button" popovertarget={`pop-${p.id}`} popovertargetaction="hide" aria-label="Fermer">×</button>
          <h3>{p.data.title}</h3>
          {p.data.tagline && <p class="ligne">{p.data.tagline}</p>}
          {p.data.links.length > 0 && (
            <ul class="pop-liens">{p.data.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}</ul>
          )}
          <button class="pop-fiche" type="button" command="show-modal" commandfor={`fiche-${p.id}`}>Voir la fiche du projet</button>
        </div>
      </div>
    ))}
  </div>
  <figcaption>Chaque point est un projet du collectif, placé entre expérimental et dansant, dark et chill. Cliquez sur un point pour le découvrir.</figcaption>
</figure>
