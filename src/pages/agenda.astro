---
import Base from '../layouts/Base.astro';
import Evenement from '../components/Evenement.astro';
import { evenements } from '../lib/events';
const { avenir, passés } = await evenements();
---
<Base title="Agenda" description="Concerts, sessions, ateliers et soirées du collectif Patchbay.">
  <h1>Agenda</h1>
  <section>
    <h2>À venir</h2>
    {avenir.length > 0
      ? <ul class="evts">{avenir.map((e) => <Evenement e={e} />)}</ul>
      : <p>Rien d’annoncé pour l’instant. Les dates seront publiées ici dès qu’elles sont confirmées.</p>}
  </section>
  {passés.length > 0 && (
    <section>
      <h2>Passé</h2>
      <ul class="evts">{passés.map((e) => <Evenement e={e} />)}</ul>
    </section>
  )}
</Base>
