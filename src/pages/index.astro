---
import Base from '../layouts/Base.astro';
import Carte from '../components/Carte.astro';
import Evenement from '../components/Evenement.astro';
import { getCollection } from 'astro:content';
import { evenements } from '../lib/events';

const projets = await getCollection('projets');
const { avenir } = await evenements();
---
<Base>
  <div class="hero">
    <h1 class="logo">
      <picture>
        <source media="(prefers-color-scheme: dark)" srcset="/logo/square-dark-transparent.svg" />
        <img src="/logo/square-light-transparent.svg" alt="Patchbay" width="320" height="320" />
      </picture>
    </h1>
    <p class="chapo">Un collectif pour les musiques électroniques live à Grenoble, des recherches sonores aux sets les plus dansants.</p>
    <p class="liens">
      <a class="bouton" href="/agenda/">Voir l’agenda</a>
      <a class="bouton" href="/a-propos/">Découvrir le collectif</a>
    </p>
  </div>

  <section>
    <h2>Cartographie du live</h2>
    <p class="chapo">De l’expérimental au dansant, du dark au chill : où se situent les projets du collectif.</p>
    <Carte projets={projets} />
  </section>

  <section>
    <h2>Prochaines dates</h2>
    {avenir.length > 0
      ? <ul class="evts">{avenir.slice(0, 3).map((e) => <Evenement e={e} />)}</ul>
      : <p>Les prochaines dates arrivent bientôt.</p>}
    <p><a href="/agenda/">Tout l’agenda</a></p>
  </section>

  <section class="texte">
    <h2>Un collectif, pas un label</h2>
    <p>Patchbay est une vitrine commune. Elle s’appuie sur ce que chacun·e porte déjà (micro-labels, collectifs, associations) pour monter des soirées à plusieurs projets, des sessions, des ateliers et une compilation.</p>
  </section>
</Base>
