---
import Base from '../layouts/Base.astro';
import Carte from '../components/Carte.astro';
import Evenement from '../components/Evenement.astro';
import { getCollection } from 'astro:content';
import { evenements } from '../lib/events';

const projets = await getCollection('projets');
const { avenir } = await evenements();
---
<Base>
  <div class="hero">
    <div>
      <h1 class="logo">
        <span class="visually-hidden">Patchbay</span>
        <span class="wordmark" aria-hidden="true">
          <span class="mot">Patch</span>
          <span class="mot">Bay</span>
          <span class="cable-logo"></span>
        </span>
      </h1>
      <p class="chapo">Un collectif pour les musiques électroniques live à Grenoble, des recherches sonores aux plateaux les plus dansants.</p>
      <p class="liens">
        <a class="bouton" href="/agenda/">Voir l’agenda</a>
        <a class="bouton" href="/a-propos/">Découvrir le collectif</a>
      </p>
    </div>
    <Carte projets={projets} />
  </div>

  <section>
    <h2>Prochaines dates</h2>
    {avenir.length > 0
      ? <ul class="evts">{avenir.slice(0, 3).map((e) => <Evenement e={e} />)}</ul>
      : <p>Les prochaines dates arrivent bientôt.</p>}
    <p><a href="/agenda/">Tout l’agenda</a></p>
  </section>

  <section class="texte">
    <h2>Un collectif, pas un label</h2>
    <p>Patchbay est une vitrine commune. Elle s’appuie sur ce que chacun·e porte déjà (micro-labels, collectifs, associations) pour monter des plateaux à plusieurs projets, des sessions, des ateliers et une compilation.</p>
  </section>
</Base>
