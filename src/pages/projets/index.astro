---
import Base from '../../layouts/Base.astro';
import Carte from '../../components/Carte.astro';
import { getCollection } from 'astro:content';
const projets = (await getCollection('projets')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'fr'));
---
<Base title="Projets" description="Les projets de musiques électroniques live réunis dans le collectif Patchbay.">
  <h1>Projets</h1>
  <div class="deux">
    <Carte projets={projets} />
    <ul class="liste-projets">
      {projets.map((p) => (
        <li>
          <h2><a href={`/projets/${p.id}/`}>{p.data.title}</a></h2>
          {p.data.tagline && <p>{p.data.tagline}</p>}
        </li>
      ))}
    </ul>
  </div>
</Base>
