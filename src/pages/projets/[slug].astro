---
import Base from '../../layouts/Base.astro';
import FicheProjet from '../../components/FicheProjet.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const projets = await getCollection('projets');
  return projets.map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
---
<Base title={p.data.title} description={p.data.tagline}>
  <article>
    <h1>{p.data.title}</h1>
    <FicheProjet p={p} />
    <p><a href="/#carte">← Retour à la carte</a></p>
  </article>
</Base>
